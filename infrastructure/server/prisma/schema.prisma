generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  first_name      String
  last_name       String
  email           String   @unique
  password        String
  role            UserRole
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  email_confirmed Boolean @default(false) @map("email_confirmed")

  // Relations
  accounts    Account[]
  orders      Order[]
  portfolio   Portfolio[]
  loans       Loan[]
  chats_as_client Chat[] @relation("ClientChats")
  chats_as_advisor Chat[] @relation("AdvisorChats")
  chats_transferred_from Chat[] @relation("TransferredChats")
  messages    Message[]
  savings_rates_updated SavingsRate[]
  message_reads         MessageRead[] @relation("UserReads")
  savings_books         SavingsBook[]

  @@map("users")
}

model EmailConfirmation {
  id         String   @id @default(uuid())
  user_id    String   @map("user_id")
  token      String   @unique
  expires_at DateTime @map("expires_at")
  confirmed  Boolean  @default(false)
  created_at DateTime @default(now()) @map("created_at")

  @@map("email_confirmations")
}

model Account {
  id         String   @id @default(uuid())
  user_id    String
  iban       String   @unique
  name       String
  balance    Decimal  @default(0.00) @db.Decimal(15, 2)
  is_savings Boolean  @default(false)
  created_at DateTime @default(now())

  // Relations
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions_source Transaction[] @relation("SourceTransactions")
  transactions_target Transaction[] @relation("TargetTransactions")

  @@map("accounts")
}

model SavingsRate {
  id            String          @id @default(uuid())
  rate          Decimal         @db.Decimal(5, 4)
  book_type     SavingsBookType
  effective_date DateTime
  updated_by    String
  created_at    DateTime        @default(now())

  // Relations
  updated_by_user User @relation(fields: [updated_by], references: [id])

  @@map("savings_rates")
}

model SavingsBook {
  id         String          @id @default(uuid())
  user_id    String
  iban       String          @unique
  name       String
  balance    Decimal         @default(0.00) @db.Decimal(15, 2)
  type       SavingsBookType
  created_at DateTime        @default(now())

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  daily_interests DailyInterest[]

  @@map("savings_books")
}

model DailyInterest {
  id              String   @id @default(uuid())
  savings_book_id String
  amount          Decimal  @db.Decimal(15, 4)
  rate            Decimal  @db.Decimal(10, 8)
  applied_at      DateTime @default(now())

  // Relations
  savings_book SavingsBook @relation(fields: [savings_book_id], references: [id], onDelete: Cascade)

  @@map("daily_interests")
}

model Transaction {
  id               String          @id @default(uuid())
  source_account_id String?
  target_account_id String?
  target_iban      String?
  amount           Decimal         @db.Decimal(15, 2)
  description      String?
  type             TransactionType
  created_at       DateTime        @default(now())

  // Relations
  source_account Account? @relation("SourceTransactions", fields: [source_account_id], references: [id], onDelete: SetNull)
  target_account Account? @relation("TargetTransactions", fields: [target_account_id], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Stock {
  id            String   @id @default(uuid())
  name          String
  symbol        String   @unique
  isin          String   @unique
  current_price Int      @map("current_price") // Stored in cents
  active        Boolean  @default(true)
  created_at    DateTime @default(now())

  // Relations
  orders    Order[]
  portfolio Portfolio[]

  @@map("stocks")
}

model Order {
  id          String      @id @default(uuid())
  user_id     String
  stock_id    String
  type        OrderType
  limit_price Int         @map("limit_price") // Stored in cents
  quantity    Int
  fee         Int         @default(0) // Stored in cents
  status      OrderStatus @default(PENDING)
  created_at  DateTime    @default(now())

  // Relations
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stock_id], references: [id], onDelete: Cascade)
  buy_trades  Trade[] @relation("BuyTrades")
  sell_trades Trade[] @relation("SellTrades")

  @@map("orders")
}

model Portfolio {
  user_id    String
  stock_id   String
  quantity   Int
  updated_at DateTime @updatedAt

  // Relations
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@id([user_id, stock_id])
  @@map("portfolios")
}

model Trade {
  id            String   @id @default(uuid())
  buy_order_id  String
  sell_order_id String
  price         Int      // Execution price in cents
  quantity      Int
  fee           Int      // Fee in cents
  aggressor_side OrderType @default(BUY) // Default to BUY for migration, but logic should set it
  timestamp     DateTime @default(now())

  // Relations
  buy_order  Order @relation("BuyTrades", fields: [buy_order_id], references: [id])
  sell_order Order @relation("SellTrades", fields: [sell_order_id], references: [id])

  @@map("trades")
}

model Loan {
  id             String   @id @default(uuid())
  user_id        String
  amount         Decimal  @db.Decimal(15, 2)
  annual_rate    Decimal  @db.Decimal(5, 4)
  insurance_rate Decimal  @db.Decimal(5, 4)
  months         Int
  created_at     DateTime @default(now())

  // Relations
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  installments Installment[]

  @@map("loans")
}

model Installment {
  id        String   @id @default(uuid())
  loan_id   String
  principal Decimal  @db.Decimal(15, 2)
  interest  Decimal  @db.Decimal(15, 2)
  insurance Decimal  @db.Decimal(15, 2)
  total     Decimal  @db.Decimal(15, 2)
  due_date  DateTime
  paid      Boolean  @default(false)
  created_at DateTime @default(now())

  // Relations
  loan Loan @relation(fields: [loan_id], references: [id], onDelete: Cascade)

  @@map("installments")
}

model Chat {
  id                   String   @id @default(uuid())
  subject              String
  client_id            String
  advisor_id           String?
  transferred_from_id  String?
  status               ChatStatus @default(OPEN)
  priority             ChatPriority @default(LOW)
  open                 Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  client           User      @relation("ClientChats", fields: [client_id], references: [id], onDelete: Cascade)
  advisor          User?     @relation("AdvisorChats", fields: [advisor_id], references: [id], onDelete: SetNull)
  transferred_from User?     @relation("TransferredChats", fields: [transferred_from_id], references: [id], onDelete: SetNull)
  messages         Message[]

  @@map("chats")
}

model Message {
  id             BigInt   @id @default(autoincrement())
  chat_id        String
  author_id      String
  content        String
  attachment_url String?
  edited         Boolean  @default(false)
  deleted        Boolean  @default(false)
  sent_at        DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  chat   Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  author User @relation(fields: [author_id], references: [id], onDelete: Cascade)
  reads  MessageRead[]

  @@map("messages")
}

model MessageRead {
  message_id BigInt
  user_id    String
  read_at    DateTime @default(now())

  // Relations
  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User    @relation("UserReads", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([message_id, user_id])
  @@map("messages_reads")
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatPriority {
  LOW
  MEDIUM
  HIGH
}


enum UserRole {
  CLIENT
  DIRECTOR
  ADVISOR
}

enum TransactionType {
  DEBIT
  CREDIT
  TRANSFER
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  EXECUTED
  CANCELLED
}

enum SavingsBookType {
  LIVRET_A
  LDD
}
